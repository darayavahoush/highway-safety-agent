[Unit]
Description=Highway Safety & Accident Prevention Autonomous Agent
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/highway-safety-agent
Environment="PATH=/opt/highway-safety-agent/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="OMP_NUM_THREADS=4"
Environment="OPENBLAS_NUM_THREADS=4"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/highway-safety-agent/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
