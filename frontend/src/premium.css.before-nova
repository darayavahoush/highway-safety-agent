/* HIGHWAY SAFETY AGENT — AFTER DARK
   Expressive editorial shell; legible operational workspace. */

:root {
  color-scheme: dark;
  --premium-bg: #090914;
  --premium-surface: #11111f;
  --premium-raised: #1a1a2b;
  --premium-line: #303047;
  --premium-text: #f7f4ff;
  --premium-muted: #aaa7c2;
  --premium-faint: #77748f;
  --premium-accent: #c4a0ff;
  --premium-green: #7df0c2;
  --premium-red: #ff718b;
  --premium-font: 'IBM Plex Sans', Inter, system-ui, sans-serif;
}

:root[data-theme="light"] {
  color-scheme: light;
  --premium-bg: #f5f1ff;
  --premium-surface: #fff;
  --premium-raised: #ebe5fa;
  --premium-line: #d8cfea;
  --premium-text: #201634;
  --premium-muted: #655a7b;
  --premium-faint: #89809d;
  --premium-accent: #7139d8;
  --premium-green: #167b5a;
  --premium-red: #c82e58;
}

html, body { background: var(--premium-bg); }
body {
  color: var(--premium-text);
  font-family: var(--premium-font);
  background-image: none;
}
button, input, select, textarea { font: inherit; }
button { -webkit-tap-highlight-color: transparent; }
button:focus-visible, a:focus-visible, input:focus-visible,
select:focus-visible, textarea:focus-visible {
  outline: 2px solid var(--premium-accent);
  outline-offset: 3px;
}
.app { background: var(--premium-bg); color: var(--premium-text); }
.app--home { display: block; height: auto; min-height: 100vh; overflow: clip; }

/* LANDING — cinematic, colourful, editorial */

.landing-nav {
  min-height: 78px;
  padding: 0 clamp(20px, 5vw, 78px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: var(--premium-bg);
  border-bottom: 1px solid var(--premium-line);
}
.landing-wordmark {
  display: flex; align-items: center; gap: 12px;
  padding: 0; border: 0; background: none;
  color: var(--premium-text); text-align: left; cursor: pointer;
}
.landing-mark {
  display: grid; place-items: center;
  width: 42px; height: 42px; border-radius: 13px;
  background: linear-gradient(140deg, #bd83ff, #6757ff 55%, #3cbbff);
  box-shadow: 0 0 32px #9062ff45;
}
.landing-mark svg { width: 27px; height: 27px; }
.landing-mark path:first-child { fill: none; stroke: #fff; stroke-width: 1.6; }
.landing-mark path:last-child {
  fill: none; stroke: #fff; stroke-width: 2;
  stroke-linecap: round; stroke-linejoin: round;
}
.landing-wordmark strong, .landing-wordmark small { display: block; }
.landing-wordmark strong { font-size: 12px; letter-spacing: .12em; }
.landing-wordmark small {
  margin-top: 4px; color: var(--premium-muted);
  font-size: 9px; letter-spacing: .18em;
}
.landing-nav-right { display: flex; align-items: center; gap: 18px; }
.landing-nav-label {
  color: var(--premium-faint);
  font: 10px var(--font-plate, monospace); letter-spacing: .15em;
}
.theme-toggle {
  padding: 10px 13px; border: 1px solid var(--premium-line);
  border-radius: 7px; color: var(--premium-text);
  background: var(--premium-surface); cursor: pointer;
}
.theme-toggle:hover { border-color: var(--premium-accent); }
.landing-nav-enter {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 17px; border: 0; border-radius: 7px;
  background: linear-gradient(115deg, #c9a1ff, #8d80ff 58%, #6edaff);
  color: #151020; font-size: 12px; font-weight: 750; cursor: pointer;
}
.landing-nav-enter:hover, .landing-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 9px 30px #9a70ff38;
}
.landing-nav-enter svg, .landing-primary svg { width: 17px; height: 17px; }

.landing { max-width: 1900px; margin: auto; }
.landing-hero {
  position: relative; isolation: isolate; overflow: hidden;
  min-height: min(760px, 82vh);
  display: flex; align-items: center;
  border-bottom: 1px solid var(--premium-line);
  background: #090914;
}
.landing-hero-image {
  position: absolute; z-index: -2; inset: 0;
  background-image:
    url('https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=2200&q=85');
  background-position: center 58%; background-size: cover;
  filter: saturate(.85);
  transform: scale(1.025);
}
.landing-hero-shade {
  position: absolute; z-index: -1; inset: 0;
  background:
    linear-gradient(90deg, #090914 0%, #090914ed 32%, #090914a8 57%, #09091430 100%),
    linear-gradient(0deg, #090914d9, transparent 38%, #09091440);
}
:root[data-theme="light"] .landing-hero-shade {
  background: linear-gradient(90deg, #171020f2, #171020d9 38%, #17102070 72%, #17102030),
              linear-gradient(0deg, #17102099, transparent 60%);
}
.landing-hero-content {
  width: min(950px, 90%);
  padding: 92px clamp(25px, 9vw, 145px) 76px;
}
.landing-eyebrow, .landing-kicker {
  display: flex; align-items: center; gap: 11px;
  color: var(--premium-accent);
  font-size: 10px; font-weight: 750; letter-spacing: .2em;
}
.landing-eyebrow-line { width: 32px; height: 2px; background: #c5a0ff; }
.landing-hero h1 {
  margin: 28px 0 25px; color: #fff;
  font-size: clamp(52px, 7.6vw, 104px);
  line-height: .94; font-weight: 680; letter-spacing: -.075em;
}
.landing-hero h1 span {
  color: #d2b1ff;
  background: linear-gradient(95deg, #f3c4ff 0%, #bba1ff 43%, #82dfff 88%);
  background-clip: text; -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.landing-lede {
  max-width: 490px; color: #d0cbdc;
  font-size: clamp(14px, 1.3vw, 17px); line-height: 1.85;
}
.landing-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 34px; }
.landing-primary {
  display: inline-flex; align-items: center; justify-content: center; gap: 17px;
  padding: 15px 20px; border: 0; border-radius: 7px;
  background: linear-gradient(110deg, #d5a8ff, #a89bff 60%, #86dcff);
  color: #171025; font-size: 12px; font-weight: 800; cursor: pointer;
  transition: transform .2s, box-shadow .2s;
}
.landing-secondary {
  display: inline-flex; align-items: center; gap: 9px;
  color: #ded8ed; text-decoration: none; font-size: 12px;
}
.landing-secondary:hover { color: #d2b1ff; }
.landing-hero-foot {
  display: flex; gap: 22px; flex-wrap: wrap;
  margin-top: 68px; color: #b3adc5;
  font-size: 9px; letter-spacing: .16em;
}
.landing-side-index {
  position: absolute; right: clamp(22px, 4vw, 58px); bottom: 38px;
  display: flex; align-items: center; gap: 10px;
  color: #eee7fa; font-size: 10px;
}
.landing-side-index i {
  width: 55px; height: 2px;
  background: linear-gradient(90deg, #bd83ff, #6edaff);
}

/* A bright accent strip, then quiet content: intensity with breathing room */

.landing-status {
  display: grid; grid-template-columns: 1.45fr 1fr 1fr 1fr;
  padding: 29px clamp(22px, 6vw, 88px);
  background: var(--premium-surface);
  border-bottom: 1px solid var(--premium-line);
  box-shadow: inset 0 3px 0 #a78bfa;
}
.landing-status-intro { padding-right: 28px; }
.landing-status-intro .landing-kicker { font-size: 9px; }
.landing-status-intro h2 {
  margin-top: 10px; font-size: 20px; font-weight: 650; letter-spacing: -.04em;
}
.landing-status-item {
  display: flex; align-items: center; gap: 13px;
  padding: 8px 18px; border-left: 1px solid var(--premium-line);
}
.landing-status-icon {
  display: grid; place-items: center; flex: 0 0 38px; height: 38px;
  border-radius: 10px; color: #d4b6ff;
  background: linear-gradient(145deg, #a982ff2c, #65d7ff14);
  border: 1px solid #a982ff55;
}
.landing-status-item div > span {
  display: block; color: var(--premium-faint); font-size: 9px; letter-spacing: .12em;
}
.landing-status-item strong {
  display: block; margin-top: 6px; font-size: 12px; font-weight: 700;
}
.landing-capabilities { padding: 88px clamp(22px, 8vw, 116px) 96px; }
.landing-section-heading {
  display: flex; justify-content: space-between; align-items: end;
  gap: 35px; margin-bottom: 35px;
}
.landing-section-heading h2, .landing-cta h2 {
  margin-top: 14px; font-size: clamp(32px, 4.3vw, 50px);
  line-height: 1.08; font-weight: 650; letter-spacing: -.06em;
}
.landing-section-heading > p {
  max-width: 380px; margin-bottom: 4px; color: var(--premium-muted);
  font-size: 13px; line-height: 1.85;
}
.landing-capability-grid {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}
.landing-capability {
  position: relative; min-height: 220px; padding: 27px 27px 34px;
  border: 1px solid var(--premium-line); border-radius: 13px;
  background: var(--premium-surface);
  transition: transform .2s, border-color .2s;
}
.landing-capability:hover { transform: translateY(-4px); border-color: #a78bfa; }
.landing-capability:nth-child(2) { background: linear-gradient(145deg, #211832, var(--premium-surface) 70%); }
.landing-capability:nth-child(3) { background: linear-gradient(145deg, #10232c, var(--premium-surface) 70%); }
.landing-capability-top {
  display: flex; align-items: center; justify-content: space-between; color: #c4a0ff;
}
.landing-capability-top span { color: var(--premium-faint); font-size: 9px; letter-spacing: .13em; }
.landing-capability h3 {
  margin: 38px 0 12px; font-size: 20px; font-weight: 700; letter-spacing: -.04em;
}
.landing-capability p { color: var(--premium-muted); font-size: 12px; line-height: 1.85; }
.landing-capability-rule {
  position: absolute; bottom: 0; left: 27px; width: 44px; height: 3px;
  border-radius: 4px; background: linear-gradient(90deg, #c4a0ff, #6edaff);
}
.landing-cta {
  display: flex; align-items: center; justify-content: space-between; gap: 28px;
  padding: 46px clamp(22px, 8vw, 116px);
  background: linear-gradient(110deg, #231736, #17172d 58%, #11232d);
  border-block: 1px solid var(--premium-line);
}
.landing-cta h2 { color: #fff; }
.landing-footer {
  display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
  padding: 23px clamp(22px, 6vw, 88px);
  color: var(--premium-faint); font-size: 9px; letter-spacing: .06em;
}
.landing-footer i { padding: 0 6px; color: var(--premium-accent); font-style: normal; }

/* COMMAND CENTRE — hierarchy first, drama around the edges */

.app--control {
  display: grid; grid-template-rows: auto minmax(0, 1fr) auto;
  min-height: 100vh; height: 100dvh; overflow: hidden;
}
.app--control .topbar {
  min-height: 72px; padding: 10px 18px;
  background: var(--premium-surface);
  border-bottom: 1px solid var(--premium-line);
  box-shadow: inset 0 2px 0 #a78bfa;
}
.app--control .brand-title-wrap h1 {
  color: var(--premium-text); font-size: 13px; letter-spacing: .08em;
}
.app--control .brand-text p { color: var(--premium-muted); font-size: 10px; }
.app--control .brand-badge {
  border-color: #9f82e855; color: var(--premium-accent);
}
.control-home-button, .topbar-icon-button {
  display: grid; place-items: center; flex: 0 0 auto;
  width: 36px; height: 36px; border: 1px solid var(--premium-line);
  border-radius: 9px; color: var(--premium-muted);
  background: var(--premium-raised); cursor: pointer;
}
.control-home-button:hover, .topbar-icon-button:hover {
  color: var(--premium-text); border-color: var(--premium-accent);
}
.app--control .topbar-right { gap: 10px; }
.app--control .topbar-about-btn {
  border: 1px solid var(--premium-line); border-radius: 8px;
  background: transparent; color: var(--premium-muted);
}
.app--control .topbar-about-btn:hover {
  border-color: var(--premium-accent); color: var(--premium-text);
}
.app--control .pill { border-radius: 6px; }

.app--control .main {
  min-height: 0; min-width: 0; overflow: hidden;
  grid-template-columns: minmax(250px, 290px) minmax(360px, 1fr) minmax(280px, 335px);
  gap: 12px; padding: 12px;
  background:
    radial-gradient(ellipse at 50% 0%, #8c69ff0b, transparent 48%),
    var(--premium-bg);
}
.app--control .col { gap: 12px; min-width: 0; }
.app--control .panel {
  min-width: 0; overflow: hidden;
  background: var(--premium-surface);
  border: 1px solid var(--premium-line);
  border-radius: 10px;
  box-shadow: 0 8px 28px #00000012;
}
.app--control .panel-head {
  border-bottom: 1px solid var(--premium-line);
  background: var(--premium-raised);
}
.app--control .panel-head h2 { color: var(--premium-text); }
.app--control .stage {
  flex: 1 1 0; min-height: 0;
  border-color: #9d7aff55;
  box-shadow: 0 0 0 1px #9d7aff0b, 0 12px 35px #00000018;
}
.app--control .stage-body { background: var(--premium-bg); }
.app--control .col--stage > .activity {
  flex: 0 1 205px; min-height: 130px; max-height: 32%;
}
.app--control .stats-strip {
  border-top: 1px solid var(--premium-line);
  background: var(--premium-surface);
}
.app--control .stage .seg button[aria-selected="true"] {
  color: var(--premium-text);
  background: #9870ed22;
  box-shadow: inset 0 -2px #b99aff;
}
.app--control .stage-caption { color: var(--premium-muted); }

/* Light theme: keep the same personality, not merely inverted colours. */
:root[data-theme="light"] body { background: var(--premium-bg); }
:root[data-theme="light"] .app--control .panel,
:root[data-theme="light"] .app--control .topbar,
:root[data-theme="light"] .app--control .stats-strip {
  color: var(--premium-text);
}
:root[data-theme="light"] .app--control .stage-body { background: #ece6f8; }
:root[data-theme="light"] .app--control .panel-head { background: #f0ebfa; }
:root[data-theme="light"] .app--control .stage .seg button[aria-selected="true"] {
  background: #7542d91b;
}
:root[data-theme="light"] .landing-capability:nth-child(2) {
  background: linear-gradient(145deg, #eee5ff, #fff 75%);
}
:root[data-theme="light"] .landing-capability:nth-child(3) {
  background: linear-gradient(145deg, #e0f5f5, #fff 75%);
}
:root[data-theme="light"] .landing-cta {
  background: linear-gradient(110deg, #e8ddff, #f0eafd 58%, #dff5fa);
}
:root[data-theme="light"] .landing-cta h2 { color: #201634; }

/* Responsive behaviour */
@media (max-width: 1180px) {
  .landing-status { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px 0; }
  .landing-status-intro { grid-column: 1 / -1; }
  .landing-status-item:first-of-type { border-left: 0; padding-left: 0; }
  .app--control { height: auto; min-height: 100vh; overflow: visible; }
  .app--control .main {
    overflow: visible;
    grid-template-columns: minmax(230px, .8fr) minmax(0, 1.5fr);
  }
  .app--control .main > .col:last-child { grid-column: 1 / -1; }
  .app--control .main > .col:last-child .panel { min-height: 250px; }
}
@media (max-width: 700px) {
  .landing-nav { min-height: 66px; padding-inline: 15px; }
  .landing-nav-label { display: none; }
  .landing-nav-right { gap: 8px; }
  .landing-nav-enter { padding: 10px; font-size: 11px; }
  .landing-wordmark strong { font-size: 10px; }
  .landing-wordmark small { font-size: 8px; }
  .landing-hero { min-height: 76svh; }
  .landing-hero-content { width: 100%; padding: 58px 24px 65px; }
  .landing-hero h1 { font-size: clamp(43px, 12vw, 67px); }
  .landing-hero-foot { margin-top: 48px; font-size: 8px; }
  .landing-side-index { display: none; }
  .landing-status { grid-template-columns: 1fr; padding: 24px 20px; }
  .landing-status-intro { grid-column: auto; }
  .landing-status-item { border-left: 0; border-top: 1px solid var(--premium-line); padding: 14px 0; }
  .landing-section-heading { display: block; }
  .landing-section-heading > p { margin-top: 16px; }
  .landing-capabilities { padding: 58px 20px; }
  .landing-capability-grid { grid-template-columns: 1fr; }
  .landing-capability { min-height: 180px; }
  .landing-capability h3 { margin-top: 26px; }
  .landing-cta { align-items: flex-start; flex-direction: column; padding: 36px 22px; }
  .landing-footer { flex-direction: column; padding: 20px 22px; }
  .app--control .topbar { flex-wrap: wrap; gap: 10px; padding: 10px 12px; }
  .app--control .brand-crest, .app--control .camera-id { display: none; }
  .app--control .brand-title-wrap h1 { font-size: 11px; }
  .app--control .brand-text p, .app--control .clock { display: none; }
  .app--control .topbar-right { flex-wrap: wrap; justify-content: flex-start; }
  .app--control .main { display: flex; flex-direction: column; padding: 8px; }
  .app--control .col { min-height: auto; }
  .app--control .stage { min-height: 430px; }
  .app--control .col--stage > .activity { min-height: 190px; max-height: none; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
  }
}
