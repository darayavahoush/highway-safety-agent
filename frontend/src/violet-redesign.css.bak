
/* =========================================================
   VIOLET / MIDNIGHT — cohesive visual system
   Loaded last to override legacy overlapping styles.
   ========================================================= */

:root {
  color-scheme: dark;
  --v-bg: #100b1c;
  --v-bg-raised: #171025;
  --v-panel: #1c1530;
  --v-panel-raised: #251b3b;
  --v-border: rgba(190, 157, 255, .17);
  --v-border-hot: rgba(184, 133, 255, .42);
  --v-purple: #a875ff;
  --v-violet: #8052ed;
  --v-lilac: #d6c0ff;
  --v-white: #f6f0ff;
  --v-muted: #aa9dbd;
  --v-faint: #776987;
  --v-glow: 0 0 36px rgba(135, 75, 255, .13);
}

html {
  background: var(--v-bg);
  scrollbar-color: #59417b var(--v-bg);
}

body {
  color: var(--v-white);
  background:
    radial-gradient(ellipse at 12% 0%, rgba(113, 62, 186, .17), transparent 35rem),
    var(--v-bg);
}

button, input, textarea, select {
  font: inherit;
}

button {
  transition: background .18s ease, border-color .18s ease,
              transform .18s ease, box-shadow .18s ease;
}

button:focus-visible, a:focus-visible, input:focus-visible,
textarea:focus-visible, select:focus-visible {
  outline: 2px solid var(--v-purple);
  outline-offset: 3px;
}

/* ---------- HOME: bold, intentional purple ---------- */

.nova-home {
  min-height: 100vh;
  color: var(--v-white) !important;
  background:
    radial-gradient(ellipse at 78% 17%, rgba(139, 74, 255, .23), transparent 31rem),
    radial-gradient(ellipse at 12% 75%, rgba(94, 45, 158, .15), transparent 32rem),
    linear-gradient(145deg, #10091e 0%, #171027 48%, #100b1c 100%) !important;
  overflow: hidden;
}

.nova-nav {
  background: rgba(16, 9, 30, .78) !important;
  border-bottom: 1px solid var(--v-border) !important;
  backdrop-filter: blur(18px);
}

.nova-brand-mark {
  color: #fff !important;
  background: linear-gradient(140deg, #b88aff, #7540df) !important;
  border: 1px solid rgba(226, 205, 255, .5) !important;
  box-shadow: 0 0 26px rgba(146, 82, 255, .32);
}

.nova-brand-type,
.nova-nav a,
.nova-nav button {
  color: var(--v-white);
}

.nova-connection {
  color: #d3c2ed !important;
}

.nova-hero {
  position: relative;
  isolation: isolate;
}

.nova-hero::before {
  opacity: .65 !important;
  background: radial-gradient(ellipse, rgba(139, 82, 255, .20), transparent 68%) !important;
  pointer-events: none;
}

.nova-overline {
  color: #c3a2ff !important;
  letter-spacing: .19em !important;
}

.nova-hero h1,
.nova-hero-title,
.nova-headline {
  color: #faf6ff !important;
  letter-spacing: -.055em;
  text-wrap: balance;
}

.nova-headline-accent,
.nova-hero h1 span {
  color: transparent !important;
  background: linear-gradient(105deg, #e6d7ff 4%, #b58aff 44%, #8a5bfa 90%);
  -webkit-background-clip: text;
  background-clip: text;
}

.nova-hero-description {
  color: #b9accb !important;
  max-width: 39rem;
  line-height: 1.8 !important;
}

.nova-button-primary,
.nova-nav-cta {
  color: #fff !important;
  background: linear-gradient(115deg, #965cf3, #7041d5) !important;
  border: 1px solid rgba(224, 204, 255, .38) !important;
  box-shadow: 0 8px 28px rgba(116, 61, 218, .25);
}

.nova-button-primary:hover,
.nova-nav-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 34px rgba(139, 78, 255, .38);
  background: linear-gradient(115deg, #aa75ff, #8050ec) !important;
}

.nova-button-text {
  color: #d6c1f4 !important;
}

.nova-proof {
  color: #b3a3c8 !important;
}

.nova-visual {
  filter: saturate(1.15);
}

.nova-ribbon,
.nova-capabilities,
.nova-manifesto,
.nova-footer {
  color: var(--v-white) !important;
  border-color: var(--v-border) !important;
}

.nova-ribbon {
  background: rgba(35, 23, 54, .72) !important;
  border-top: 1px solid var(--v-border) !important;
  border-bottom: 1px solid var(--v-border) !important;
  backdrop-filter: blur(12px);
}

.nova-ribbon strong,
.nova-ribbon [class*="value"] {
  color: #e4d2ff !important;
}

.nova-capabilities {
  background: linear-gradient(180deg, rgba(29, 20, 47, .62), rgba(16, 11, 28, .2)) !important;
}

.nova-capabilities h2,
.nova-manifesto h2 {
  color: #f7f0ff !important;
  letter-spacing: -.035em;
}

.nova-capability,
.nova-capability-card,
.nova-feature-card {
  background: linear-gradient(145deg, rgba(39, 27, 61, .86), rgba(24, 17, 39, .88)) !important;
  border: 1px solid var(--v-border) !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
  transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
}

.nova-capability:hover,
.nova-capability-card:hover,
.nova-feature-card:hover {
  transform: translateY(-3px);
  border-color: var(--v-border-hot) !important;
  box-shadow: var(--v-glow);
}

.nova-capability-violet,
.nova-capability-icon {
  color: #c9a8ff !important;
  background-color: rgba(133, 79, 220, .16) !important;
}

.nova-manifesto {
  background:
    radial-gradient(ellipse at 50% 0%, rgba(129, 70, 221, .17), transparent 70%),
    #130d21 !important;
}

.nova-footer {
  background: rgba(12, 8, 21, .7) !important;
}

/* ---------- CONTROL ROOM: compact, purposeful, readable ---------- */

.app--control {
  color: var(--v-white) !important;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(108, 65, 166, .10), transparent 45rem),
    var(--v-bg) !important;
  min-height: 100vh;
}

.app--control .topbar {
  background: rgba(20, 14, 33, .96) !important;
  border-bottom: 1px solid var(--v-border) !important;
  box-shadow: 0 5px 24px rgba(0,0,0,.14);
}

.app--control .main {
  gap: 12px !important;
  padding: 12px !important;
  align-items: start;
}

.app--control .col {
  min-width: 0;
  gap: 12px !important;
}

.app--control .panel,
.app--control .detail,
.app--control .activity,
.app--control .stats,
.app--control .copilot-container {
  color: var(--v-white) !important;
  background: linear-gradient(155deg, #201730, #181124) !important;
  border: 1px solid var(--v-border) !important;
  border-radius: 13px !important;
  box-shadow: 0 8px 26px rgba(0,0,0,.13);
}

.app--control .panel-head,
.app--control .detail-head,
.app--control .detail-foot {
  background: rgba(40, 28, 59, .62) !important;
  border-color: var(--v-border) !important;
}

.app--control .panel-head {
  padding: 11px 13px !important;
}

.app--control .panel-head h2,
.app--control .panel-head h3,
.app--control .detail h2,
.app--control .detail h3 {
  color: #eee3ff !important;
}

.app--control .stage {
  background: #0d0915 !important;
  border-color: var(--v-border) !important;
  border-radius: 10px !important;
  overflow: hidden;
}

.app--control .stage-body {
  min-height: 0;
}

.app--control .stage-caption {
  background: rgba(20, 12, 32, .94) !important;
  border-color: var(--v-border) !important;
}

.app--control .inc {
  margin: 5px 7px !important;
  padding: 9px 10px !important;
  border: 1px solid transparent !important;
  border-radius: 9px !important;
  background: rgba(255,255,255,.018) !important;
}

.app--control .inc:hover {
  background: rgba(157, 106, 255, .08) !important;
  border-color: var(--v-border) !important;
}

.app--control .inc[aria-selected="true"],
.app--control .inc.active,
.app--control .inc.is-selected {
  background: rgba(135, 78, 224, .15) !important;
  border-color: rgba(177, 131, 255, .43) !important;
}

.app--control .inc-title {
  color: #f3ebff !important;
}

.app--control .inc-sub,
.app--control .inc-plate,
.app--control .detail-body,
.app--control .activity {
  color: #b9accb !important;
}

.app--control .chip {
  border-color: var(--v-border) !important;
  background: rgba(157, 110, 239, .10) !important;
  color: #ddcaff !important;
}

.app--control .detail-body {
  padding: 12px !important;
}

.app--control .detail-fold {
  border-top: 1px solid var(--v-border) !important;
}

.app--control .detail-fold > summary {
  padding: 10px 2px !important;
  color: #d8c5f6 !important;
  cursor: pointer;
}

.app--control .detail-fold[open] > summary {
  color: #f2eaff !important;
}

.app--control .stats-grid {
  gap: 9px !important;
}

.app--control .copilot-drawer {
  background: #1a1228 !important;
  border: 1px solid var(--v-border) !important;
  box-shadow: 0 18px 60px rgba(0,0,0,.38);
}

.app--control button:not(:disabled) {
  cursor: pointer;
}

.app--control button:focus-visible {
  outline: 2px solid var(--v-purple);
  outline-offset: 2px;
}

/* Preserve severity meaning: purple is the product identity, not every alert. */
.app--control .inc-sev {
  font-weight: 700;
}

/* Tight laptop layout: use the viewport instead of padding everything out. */
@media (min-width: 1100px) and (max-height: 900px) {
  .app--control .main {
    padding: 9px !important;
    gap: 9px !important;
  }

  .app--control .col {
    gap: 9px !important;
  }

  .app--control .detail-body {
    max-height: calc(100vh - 240px);
    overflow-y: auto;
  }
}

@media (max-width: 1100px) {
  .app--control .main {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .app--control .col {
    width: 100%;
  }

  .nova-hero {
    gap: 2rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

/* Control room layout refinement */
@media (min-width: 1280px) {
  .app--control .main {
    grid-template-columns: minmax(245px, .78fr) minmax(420px, 1.55fr) minmax(320px, 1fr) !important;
    align-items: stretch !important;
    gap: 11px !important;
    padding: 11px !important;
  }

  .app--control .col {
    min-width: 0;
    min-height: 0;
    gap: 11px !important;
  }

  .app--control .col--stage > .stage {
    flex: 3 1 0;
    min-height: 340px;
  }

  .app--control .col--stage > .activity {
    flex: 1 1 0;
    min-height: 135px;
  }

  .app--control .detail-head {
    padding: 13px !important;
  }

  .app--control .detail-head h2 {
    font-size: clamp(21px, 1.6vw, 28px);
    overflow-wrap: anywhere;
  }

  .app--control .detail-body {
    min-height: 0;
    max-height: none;
    overflow-y: auto;
  }

  .app--control .stage .panel-head {
    flex-wrap: wrap;
  }
}

@media (min-width: 1101px) and (max-width: 1279px) {
  .app--control .main {
    grid-template-columns: minmax(220px, .8fr) minmax(360px, 1.3fr) minmax(290px, 1fr) !important;
    gap: 9px !important;
    padding: 9px !important;
  }

  .app--control .detail-body {
    max-height: calc(100vh - 230px);
    overflow-y: auto;
  }
}

@media (min-width: 1101px) and (max-height: 780px) {
  .app--control .col--stage > .stage {
    min-height: 300px;
  }

  .app--control .col--stage > .activity {
    min-height: 110px;
  }
}
