import {
  ArrowDownRight, ArrowRight, Activity, ShieldCheck, Radio,
  MapPinned, ScanEye, Command, ChevronRight
} from 'lucide-react'

const capabilities = [
  {
    number: '01',
    icon: ScanEye,
    title: 'Incident intelligence',
    text: 'Bring detected incidents into a single operational view for rapid assessment and prioritisation.',
  },
  {
    number: '02',
    icon: MapPinned,
    title: 'Corridor awareness',
    text: 'Explore highway corridors, incident locations and the illustrative digital-twin environment.',
  },
  {
    number: '03',
    icon: Command,
    title: 'Coordinated response',
    text: 'Move from incident review to response actions without losing operational context.',
  },
]

export default function Home({ onEnter, conn, incidents = [] }) {
  const connectionLabel = conn === 'live'
    ? 'LIVE CONNECTION'
    : conn === 'demo'
      ? 'DEMO ENVIRONMENT'
      : conn === 'offline'
        ? 'CONNECTION OFFLINE'
        : 'CONNECTING'

  return (
    <div className="landing">
      <section className="landing-hero">
        <div className="landing-hero-image" aria-hidden="true" />
        <div className="landing-hero-shade" aria-hidden="true" />

        <div className="landing-hero-content">
          <div className="landing-eyebrow">
            <span className="landing-eyebrow-line" />
            HIGHWAY SAFETY INTELLIGENCE
          </div>

          <h1>
            Every second<br />
            <span>changes the outcome.</span>
          </h1>

          <p className="landing-lede">
            A unified operational environment for highway incident
            awareness, corridor monitoring and coordinated response.
          </p>

          <div className="landing-actions">
            <button className="landing-primary" onClick={onEnter}>
              Enter control room <ArrowRight size={17} />
            </button>
            <a className="landing-secondary" href="#capabilities">
              Explore the platform <ArrowDownRight size={16} />
            </a>
          </div>

          <div className="landing-hero-foot">
            <span>HRAP / 2026</span>
            <span>ANDHRA PRADESH · INDIA</span>
          </div>
        </div>

        <div className="landing-side-index" aria-hidden="true">
          <span>01</span><i /><span>03</span>
        </div>
      </section>

      <section className="landing-status" aria-label="System overview">
        <div className="landing-status-intro">
          <span className="landing-kicker">OPERATIONAL OVERVIEW</span>
          <h2>Awareness, without the noise.</h2>
        </div>
        <div className="landing-status-item">
          <span className="landing-status-icon"><Radio size={17} /></span>
          <div><span>ENVIRONMENT</span><strong>{connectionLabel}</strong></div>
        </div>
        <div className="landing-status-item">
          <span className="landing-status-icon"><Activity size={17} /></span>
          <div><span>INCIDENT RECORDS</span><strong>{incidents.length.toString().padStart(2, '0')}</strong></div>
        </div>
        <div className="landing-status-item">
          <span className="landing-status-icon"><ShieldCheck size={17} /></span>
          <div><span>WORKSPACE</span><strong>Incident command</strong></div>
        </div>
      </section>

      <section className="landing-capabilities" id="capabilities">
        <div className="landing-section-heading">
          <div>
            <span className="landing-kicker">BUILT FOR THE MOMENT THAT MATTERS</span>
            <h2>From detection to decision.</h2>
          </div>
          <p>
            One workspace for reviewing events, understanding the corridor
            and keeping response decisions connected.
          </p>
        </div>

        <div className="landing-capability-grid">
          {capabilities.map(({ number, icon: Icon, title, text }) => (
            <article className="landing-capability" key={number}>
              <div className="landing-capability-top">
                <span>{number} / CAPABILITY</span>
                <Icon size={20} strokeWidth={1.6} />
              </div>
              <h3>{title}</h3>
              <p>{text}</p>
              <span className="landing-capability-rule" />
            </article>
          ))}
        </div>
      </section>

      <section className="landing-cta">
        <div>
          <span className="landing-kicker">THE OPERATIONS WORKSPACE</span>
          <h2>See the situation.<br />Make the next move.</h2>
        </div>
        <button className="landing-primary" onClick={onEnter}>
          Open control room <ChevronRight size={17} />
        </button>
      </section>

      <footer className="landing-footer">
        <span>HIGHWAY SAFETY AGENT <i>·</i> HRAP-2026</span>
        <span>Operational support interface <i>·</i> Not a substitute for emergency services</span>
      </footer>
    </div>
  )
}
