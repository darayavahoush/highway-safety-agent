# demo = built-in simulator (no backend needed). live = FastAPI backend.
VITE_DATA_MODE=demo

# Where the Vite dev proxy forwards /api, /ws, /mock, /evidence, /video_feed
VITE_BACKEND_URL=http://localhost:8000

# WebSocket path for incident events (see src/api/CONTRACT.md)
VITE_WS_PATH=/ws/incidents

# MJPEG stream path served by the backend (live mode only)
VITE_VIDEO_PATH=/video_feed

# Optional: URL of the existing Three.js digital twin page, shown in the Digital twin tab
VITE_TWIN_URL=
